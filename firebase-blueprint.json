{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user identifier matching auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "firstName": {
          "type": "string",
          "description": "User first name",
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "description": "User last name",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "email", "firstName"]
    },
    "UserRole": {
      "title": "UserRole",
      "description": "Security roles table for RBAC",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User ID reference",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Role assigned to the user",
          "enum": ["user", "admin"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["userId", "role"]
    },
    "JewelleryRecord": {
      "title": "JewelleryRecord",
      "description": "User jewellery recommendations, quizzes, try-ons, and saved favorites",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Record document ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User ID owning this record",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title or item name",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "description": "Category or capability type",
          "enum": ["Style Quiz", "Occasion Match", "Virtual Try-On", "Recommendation Engine", "Saved Favorites"],
          "maxLength": 64
        },
        "occasion": {
          "type": "string",
          "description": "Target occasion",
          "maxLength": 100
        },
        "metalType": {
          "type": "string",
          "description": "Metal preference",
          "maxLength": 64
        },
        "gemstone": {
          "type": "string",
          "description": "Gemstone or diamond type",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "description": "Styling notes or AI insights",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "description": "Status of the record",
          "enum": ["saved", "completed", "draft"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "title", "category", "status"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check test connection ping",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection status"
        }
      }
    },
    "StyleQuiz": {
      "title": "StyleQuiz",
      "description": "User style quiz assessments and jewellery aesthetic profiles",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique quiz document identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID referencing auth.uid",
          "maxLength": 128
        },
        "user_id": {
          "type": "string",
          "description": "Owner user ID matching auth.uid",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the Style Quiz",
          "maxLength": 200
        },
        "payload": {
          "type": "object",
          "description": "Quiz answers, preferences, metal selections, and notes"
        },
        "status": {
          "type": "string",
          "description": "Current status of the quiz",
          "enum": ["draft", "completed", "archived"],
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "title", "status"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Inquiries and contact messages submitted by prospective clients and users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique UUID or identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Sender full name",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address",
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "description": "Message or inquiry content",
          "minLength": 10,
          "maxLength": 2000
        },
        "source": {
          "type": "string",
          "description": "Submission source",
          "maxLength": 100
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "name", "email", "message"]
    },
    "AiRun": {
      "title": "AiRun",
      "description": "Historical AI run executions executed by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Run UUID or identifier",
          "maxLength": 128
        },
        "user_id": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "prompt": {
          "type": "string",
          "description": "User prompt sent to AI Gateway",
          "maxLength": 5000
        },
        "response": {
          "type": "string",
          "description": "Generated AI response",
          "maxLength": 20000
        },
        "model": {
          "type": "string",
          "description": "Model used, e.g. google/gemini-2.5-flash",
          "maxLength": 100
        },
        "capability": {
          "type": "string",
          "description": "AI capability category",
          "maxLength": 64
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "user_id", "prompt", "response", "model"]
    }
  },
  "firestore": {
    "/test/{testId}": {
      "schema": {
        "$ref": "TestConnection"
      },
      "description": "Health check document for connection verification"
    },
    "/profiles/{userId}": {
      "schema": {
        "$ref": "Profile"
      },
      "description": "User profile collection keyed by user uid"
    },
    "/user_roles/{userId}": {
      "schema": {
        "$ref": "UserRole"
      },
      "description": "Security roles table for role-based authorization"
    },
    "/jewellery_records/{recordId}": {
      "schema": {
        "$ref": "JewelleryRecord"
      },
      "description": "User records for styling, quiz outcomes, try-ons, and saved favorites"
    },
    "/style_quiz/{quizId}": {
      "schema": {
        "$ref": "StyleQuiz"
      },
      "description": "User style quiz assessments"
    },
    "/contact_messages/{messageId}": {
      "schema": {
        "$ref": "ContactMessage"
      },
      "description": "Public and authenticated client inquiry messages"
    },
    "/ai_runs/{runId}": {
      "schema": {
        "$ref": "AiRun"
      },
      "description": "Historical AI runs scoped to the authenticated owner"
    }
  }
}
