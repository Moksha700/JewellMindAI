rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin') ||
        (isSignedIn() && request.auth.token.email == 'mokshagnaande55@gmail.com');
    }

    function isValidProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.firstName is string && data.firstName.size() <= 100 &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100));
    }

    function isValidUserRole(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.role in ['user', 'admin'];
    }

    function isValidJewelleryRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category in ['Style Quiz', 'Occasion Match', 'Virtual Try-On', 'Recommendation Engine', 'Saved Favorites'] &&
             data.status in ['saved', 'completed', 'draft'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('occasion' in data) || (data.occasion is string && data.occasion.size() <= 100)) &&
             (!('metalType' in data) || (data.metalType is string && data.metalType.size() <= 64)) &&
             (!('gemstone' in data) || (data.gemstone is string && data.gemstone.size() <= 64));
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidProfile(incoming()) && incoming().id == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // User Roles Collection (Security Definer RBAC)
    match /user_roles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserRole(incoming()) &&
                    ((request.auth.uid == userId && incoming().role == 'user') || isAdmin());
      allow update: if isAdmin() && isValidUserRole(incoming());
      allow delete: if isAdmin();
    }

    // Jewellery Records Collection
    match /jewellery_records/{recordId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(recordId) && incoming().userId == request.auth.uid && isValidJewelleryRecord(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId && isValidJewelleryRecord(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
