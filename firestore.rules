rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Health Check verification
    match /test/{testId} {
      allow get: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasRole(role) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return hasRole('admin') ||
        (isSignedIn() && request.auth.token.email == 'mokshagnaande55@gmail.com');
    }

    function isValidProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.firstName is string && data.firstName.size() <= 100 &&
             (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100));
    }

    function isValidUserRole(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.role in ['user', 'admin'];
    }

    function isValidJewelleryRecord(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category in ['Style Quiz', 'Occasion Match', 'Virtual Try-On', 'Recommendation Engine', 'Saved Favorites'] &&
             data.status in ['saved', 'completed', 'draft'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('occasion' in data) || (data.occasion is string && data.occasion.size() <= 100)) &&
             (!('metalType' in data) || (data.metalType is string && data.metalType.size() <= 64)) &&
             (!('gemstone' in data) || (data.gemstone is string && data.gemstone.size() <= 64));
    }

    function isValidStyleQuiz(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['draft', 'completed', 'archived'] &&
             (('user_id' in data && data.user_id is string && data.user_id.size() <= 128) ||
              ('userId' in data && data.userId is string && data.userId.size() <= 128));
    }

    function isStyleQuizOwner(data) {
      return ('user_id' in data && data.user_id == request.auth.uid) ||
             ('userId' in data && data.userId == request.auth.uid);
    }

    function isValidContactMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 2000 &&
             (!('source' in data) || (data.source is string && data.source.size() <= 100));
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidProfile(incoming()) && incoming().id == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && isValidProfile(incoming()) && incoming().id == existing().id;
      allow delete: if isAdmin();
    }

    // User Roles Collection (Security Definer RBAC)
    match /user_roles/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(userId) && isValidUserRole(incoming()) &&
                    ((request.auth.uid == userId && incoming().role == 'user') || isAdmin());
      allow update: if isAdmin() && isValidUserRole(incoming());
      allow delete: if isAdmin();
    }

    // Jewellery Records Collection
    match /jewellery_records/{recordId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(recordId) && incoming().userId == request.auth.uid && isValidJewelleryRecord(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == existing().userId && isValidJewelleryRecord(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Style Quiz Collection (Public schema entity with RLS user_id = auth.uid())
    match /style_quiz/{quizId} {
      allow get: if isSignedIn() && (isStyleQuizOwner(resource.data) || isAdmin());
      allow list: if isSignedIn() && (isStyleQuizOwner(resource.data) || isAdmin());
      allow create: if isSignedIn() && isValidId(quizId) && isStyleQuizOwner(incoming()) && isValidStyleQuiz(incoming());
      allow update: if isSignedIn() && isStyleQuizOwner(resource.data) && isStyleQuizOwner(incoming()) && isValidStyleQuiz(incoming());
      allow delete: if isSignedIn() && (isStyleQuizOwner(resource.data) || isAdmin());
    }

    // Contact Messages Collection
    // Allow INSERT to anon + authenticated (WITH CHECK true); Allow SELECT, UPDATE, DELETE only to admins via has_role('admin')
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId) && isValidContactMessage(incoming());
      allow get: if isSignedIn() && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && isValidContactMessage(incoming());
      allow delete: if isSignedIn() && isAdmin();
    }

    function isValidAiRun(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.user_id is string && data.user_id == request.auth.uid &&
             data.prompt is string && data.prompt.size() <= 5000 &&
             data.response is string && data.response.size() <= 30000 &&
             data.model is string && data.model.size() <= 100 &&
             (!('status' in data) || (data.status is string && data.status.size() <= 30));
    }

    // AI Runs Collection (RLS scoped to owner)
    match /ai_runs/{runId} {
      allow get: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(runId) && incoming().user_id == request.auth.uid && isValidAiRun(incoming());
      allow update: if isSignedIn() && resource.data.user_id == request.auth.uid && incoming().user_id == request.auth.uid && isValidAiRun(incoming());
      allow delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }
  }
}
